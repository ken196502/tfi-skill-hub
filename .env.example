# SkillHub 环境变量模板
#
# 用法：  cp .env.example .env   然后填写下面的值
# 说明：  .env 已在 .gitignore 中（不入库），也在 .dockerignore 中（不进镜像）。
#         请勿把真实口令写进本文件 —— 本文件是要提交到仓库的。

# ── 管理员账号（必填） ─────────────────────────────────────────────
# 仅在数据库为空时用于首次创建管理员；已有账号的口令不会被改写。
# docker compose 部署时缺任意一项会直接报错退出；npm start 也会读取本文件。
# 口令至少 8 位。
SKILLHUB_ADMIN_USER=admin
SKILLHUB_ADMIN_PASSWORD=

# ── 可选 ──────────────────────────────────────────────────────────
# 公开注册开关：置 0 可关闭自注册（关闭后注册入口隐藏、提交被拒）
# SKILLHUB_ALLOW_REGISTRATION=1

# 公开访问地址，用于设备码校验的回链
# SKILLHUB_BASE_URL=https://example.com

# 监听地址 / 端口 / 数据库路径
# SKILLHUB_HOST=0.0.0.0
# SKILLHUB_PORT=10070
# SKILLHUB_DATABASE_URL=./data/skillhub.db

# 限流（次数 / 时间窗秒）
# SKILLHUB_RATE_READ_LIMIT=120
# SKILLHUB_RATE_WRITE_LIMIT=30
# SKILLHUB_RATE_DOWNLOAD_LIMIT=20

# 启用 /api/v1/agent/provision（留空则返回 404）
# SKILLHUB_AGENT_SECRET=
